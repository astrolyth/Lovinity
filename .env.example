
#Developer Tools
STUDIO_URL=http://127.0.0.1:54323
MAILPIT_URL=http://127.0.0.1:54324
MCP_URL=http://127.0.0.1:54321/mcp

#Api Endpoints
PROJECT_URL=http://127.0.0.1:54321
REST_URL=http://127.0.0.1:54321/rest/v1
GRAPHQL_URL=http://127.0.0.1:54321/graphql/v1
FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1

#Supabase (regenerate after `supabase start` with: supabase status -o env)
SUPABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

#Storage S3
S3_URL=http://127.0.0.1:54321/storage/v1/s3
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=local

#Mailpit — LOCAL auth email needs NO config: the built-in Mailpit inbox at
#MAILPIT_URL captures it (free, self-contained). Fill these in ONLY if you
#enable [auth.email.smtp] in supabase/config.toml to point at a self-hosted
#Mailpit for cloud/staging. Leave blank for local dev.
MAILPIT_SMTP_HOST=
MAILPIT_SMTP_USER=
MAILPIT_SMTP_PASS=
