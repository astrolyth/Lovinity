<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget background. Rounded to match the launcher's own widget corners on
  Android 12+, which clips to a system radius; a square background would show
  hard corners poking out beyond the clip on some launchers.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1F1B2E" />
    <corners android:radius="20dp" />
</shape>
