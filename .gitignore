#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json
.env
# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Supabase generated cache
supabase/.temp/

# Cloud Supabase dart-define config (real values)
config/supabase.cloud.json
config/supabase.local.json

# Firebase native config -- per-project secrets the operator adds locally,
# never committed (push notifications degrade gracefully without them; see
# lib/core/notifications/push_service.dart and android/app/build.gradle.kts).
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
**/*serviceAccount*.json
**/*service-account*.json
